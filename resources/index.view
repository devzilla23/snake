  <defs>
    <symbol id="snake-head">
    <g id="g-instance" transform="translate(50%,50%)"> 
      <animateTransform id="g-transform" attributeType="rotate" from="0" to="90" begin="enable" dur="0.25" final="keep" />
      <line id ="color_snake" x1="-3" y1="-1" x2="2" y2="-1" class="snake-line"/>
      <circle fill="black" cx="-2" cy="-4" r="2"/>
      <circle fill="black" cx="-2" cy="3" r="2"/>
    </g>
    </symbol>
  </defs>

  
